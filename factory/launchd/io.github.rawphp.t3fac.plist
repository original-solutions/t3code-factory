<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The --port and log path below are repeated in factory/scripts/lib/t3fac.sh for the health check. -->
<dict>
	<key>Label</key>
	<string>io.github.rawphp.t3fac</string>
	<!-- ~/.config/t3fac/env, when it exists, is sourced first: the machine's own PATH and environment
	     for the tools its repos provision and gate with. The template names no tool. The PATH that
	     results is exported as T3FAC_LAUNCH_PATH, so the factory can put it ahead of the login-shell
	     PATH the server merges in at startup for every command it runs, provision and gate included. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>if [ -f "@HOME@/.config/t3fac/env" ]; then . "@HOME@/.config/t3fac/env"; fi; export T3FAC_LAUNCH_PATH="$PATH"; exec "@HOME@/.local/share/t3fac/current/t3" serve --base-dir "@HOME@/.config/t3fac" --port 3876</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@HOME@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:@HOME@/.local/bin:@HOME@/.local/share/vite-plus/bin</string>
		<key>GH_CONFIG_DIR</key>
		<string>@HOME@/.config/t3fac/gh</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/t3fac/t3fac.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/t3fac/t3fac.log</string>
</dict>
</plist>
